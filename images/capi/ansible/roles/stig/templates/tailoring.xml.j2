<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by image-builder's stig role. Exceptions and their justifications: exceptions.md -->
<xccdf:Tailoring xmlns:xccdf="http://checklists.nist.gov/xccdf/1.2" id="xccdf_org.ssgproject.content_tailoring_kubernetes_node">
  <xccdf:benchmark href="{{ stig_datastream }}"/>
  <xccdf:version time="{{ ansible_date_time.iso8601 }}">1</xccdf:version>
{% for p in [{'id': 'stig_kubernetes_node', 'extra': []}, {'id': 'stig_kubernetes_node_build', 'extra': stig_build_phase_deselect}] %}
  <xccdf:Profile id="xccdf_org.ssgproject.content_profile_{{ p.id }}" extends="{{ stig_profile }}">
    <xccdf:title xml:lang="en-US">DISA STIG - Kubernetes node{{ ' (build phase)' if p.extra else '' }}</xccdf:title>
    <xccdf:description xml:lang="en-US">DISA STIG profile with the documented Kubernetes node exceptions listed in exceptions.md.</xccdf:description>
{% for e in stig_all_exceptions %}
    <xccdf:select idref="xccdf_org.ssgproject.content_rule_{{ e.rule }}" selected="false"/>
{% endfor %}
{% for r in p.extra %}
    <xccdf:select idref="xccdf_org.ssgproject.content_rule_{{ r }}" selected="false"/>
{% endfor %}
  </xccdf:Profile>
{% endfor %}
</xccdf:Tailoring>
